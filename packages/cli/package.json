{
	"name": "@apple-cua/cli",
	"version": "0.1.0",
	"type": "module",
	"description": "Command-line interface for macOS computer control",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/trac3r00/apple-cua.git",
		"directory": "packages/cli"
	},
	"keywords": ["macos", "automation", "cli", "computer-use"],
	"bin": {
		"apple-cua": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsgo",
		"typecheck": "tsgo --noEmit",
		"test": "vitest --run",
		"prepack": "mkdir -p resources && cp ../../scripts/tcc-helper-launcher.c resources/"
	},
	"dependencies": {
		"@apple-cua/browser": "workspace:*",
		"@apple-cua/core": "workspace:*",
		"@apple-cua/mcp": "workspace:*",
		"commander": "^12.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"execa": "9.6.0",
		"typescript": "^5.7.0",
		"vitest": "^2.1.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"files": ["dist", "resources", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public"
	}
}
