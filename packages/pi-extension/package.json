{
	"name": "@opencua/pi-extension",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Pi coding agent extension bridging to the guarded opencua MCP server for macOS computer control",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/trac3r00/opencua.git",
		"directory": "packages/pi-extension"
	},
	"keywords": ["pi-extension", "pi-mono", "macos", "computer-use", "mcp"],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsgo -p tsconfig.build.json",
		"typecheck": "tsgo --noEmit",
		"test": "bun test --isolate --parallel=4"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.0.0",
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"@mariozechner/pi-coding-agent": "^0.73.1",
		"@types/node": "^20.0.0",
		"typescript": "^5.7.0"
	},
	"peerDependencies": {
		"@mariozechner/pi-ai": "*",
		"@mariozechner/pi-coding-agent": "*"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
