index 000000000..65798557c
--- /dev/null
+++ b/libs/cua-driver-bench/automated-eval/macos_bench/tests/test_apple_cua_arm.py
@@ -0,0 +1,58 @@
+"""Offline contract tests for the added apple-cua arm; no GUI or model calls."""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+from unittest import mock
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import arms
+import claude_arms as ca
+
+
+def test_given_registered_arm_when_configured_then_only_pinned_server(tmp_path: Path) -> None:
+    settings = {
+        "helper_launcher": "/pinned/helper",
+        "server": "/pinned/server.js",
+        "allowed_bundle_ids": ["ai.cua.benchlab", "com.apple.calculator"],
+    }
+    (tmp_path / "apple-cua.json").write_text(json.dumps(settings))
+    with mock.patch.object(ca, "WORK", tmp_path), mock.patch.dict(
+        "os.environ", {"OPENCUA_IPHONE": "1", "UNRELATED_SECRET": "not-forwarded"}
+    ):
+        path, server = ca.mcp_config_for("cc-apple-cua", tmp_path / "run")
+    entry = json.loads(path.read_text())["mcpServers"][server]
+    assert "cc-apple-cua" in arms.ALL_ARMS
+    assert server == "apple-cua"
+    assert entry["command"] == settings["helper_launcher"]
+    assert entry["args"] == [settings["server"]]
+    assert entry["env"]["HOME"] == str(tmp_path / "apple-home")
+    assert entry["env"]["OPENCUA_DELIVERY"] == "background"
+    assert entry["env"]["OPENCUA_TOOLSET"] == "full"
+    assert entry["env"]["OPENCUA_ALLOWED_BUNDLE_IDS"] == "ai.cua.benchlab,com.apple.calculator"
+    assert "OPENCUA_IPHONE" not in entry["env"]
+    assert "UNRELATED_SECRET" not in entry["env"]
+    argv = ca.claude_argv(
+        mcp_config=path, server=server, model="offline", max_turns=45, max_budget_usd=6
+    )
+    assert argv[argv.index("--allowedTools") + 1] == "mcp__apple-cua"
+
+
+def test_given_missing_configuration_when_configured_then_fail_closed(tmp_path: Path) -> None:
+    with mock.patch.object(ca, "WORK", tmp_path), pytest.raises(FileNotFoundError):
+        ca.mcp_config_for("cc-apple-cua", tmp_path / "run")
+
+
+def test_given_comparison_skill_when_preparing_then_matching_apple_skill(tmp_path: Path) -> None:
+    skill = tmp_path / "source"
+    skill.mkdir()
+    (skill / "SKILL.md").write_text("fixture")
+    (tmp_path / "apple-cua.json").write_text(json.dumps({"skill": str(skill)}))
+    with mock.patch.object(ca, "WORK", tmp_path):
+        cwd = ca.prepare_cwd("cc-apple-cua", tmp_path / "cwd")
+    assert (cwd / ".claude/skills/apple-cua/SKILL.md").is_file()
+    assert not (cwd / ".claude/skills/cua-driver").exists()
